# App
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (default: local SQLite)
DATABASE_URL=sqlite:///./data/app.db

# LLM API Keys (optional in dev)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# LLM Routing (optional)
# DeepSeek OpenAI 兼容端点; 私有部署/代理时覆盖
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 置 1 强制 Mock 模式 (不调用真实 LLM, 开发/离线用)
LLM_MOCK_MODE=

# MCP
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080

# Auth: MySQL (local user accounts database)
AUTH_MYSQL_HOST=127.0.0.1
AUTH_MYSQL_PORT=3306
AUTH_MYSQL_USER=root
AUTH_MYSQL_PASSWORD=
AUTH_MYSQL_DATABASE=nl2sql_auth

# Auth: JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG embedding — 本地语义检索(Ollama,无需 API Key)
# 可选值: ollama(默认) | openai(需 OPENAI_API_KEY) | bge(需 sentence-transformers) | mock
RAG_EMBEDDING_PROVIDER=ollama
# Ollama 服务地址与嵌入模型(先 `ollama pull embeddinggemma`)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIM=768
