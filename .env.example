# App
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

# Database (default: local SQLite)
DATABASE_URL=sqlite:///./data/app.db

# LLM API Keys (optional in dev)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# LLM Routing (optional)
# DeepSeek OpenAI 兼容端点; 私有部署/代理时覆盖
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 置 1 强制 Mock 模式 (不调用真实 LLM, 开发/离线用)
LLM_MOCK_MODE=
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=30
LLM_COOLDOWN_SECONDS=5
LLM_RATE_LIMIT_RPM=60
QUERY_TIMEOUT_SECONDS=120
MAX_CONCURRENT_QUERIES=8
SCHEMA_CACHE_SECONDS=30
SESSION_MAX_ENTRIES=1000
SESSION_MAX_TURNS=50
SESSION_MAX_VERSIONS=100
SESSION_TTL_SECONDS=3600

# Optional local LLM usage audit: blank disables persistence.
# Enable with a private local file, e.g. data/llm_usage.sqlite3
LLM_AUDIT_PATH=
LLM_AUDIT_MAX_RECORDS=1000

# MCP
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080

# Auth: MySQL (local user accounts database)
AUTH_MYSQL_HOST=127.0.0.1
AUTH_MYSQL_PORT=3306
AUTH_MYSQL_USER=root
AUTH_MYSQL_PASSWORD=
AUTH_MYSQL_DATABASE=nl2sql_auth

# Auth: JWT
# Required in every environment; generate at least 32 random characters.
JWT_SECRET=
# Registration is disabled until an administrator configures an invitation.
REGISTRATION_TOKEN=
ADMIN_USER_IDS=[1]
CORS_ORIGINS=["http://localhost:8001","http://127.0.0.1:8001"]
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG embedding — 本地语义检索(Ollama,无需 API Key)
# 可选值: ollama(默认) | openai(需 OPENAI_API_KEY) | bge(需 sentence-transformers) | mock
RAG_EMBEDDING_PROVIDER=ollama
# Explicit index rebuild: use a new directory AND a new sparse index file.
# RAG_LANCEDB_DIR=data/lancedb-v2
# RAG_BM25_PATH=data/bm25-v2.db
# Ollama 服务地址与嵌入模型(先 `ollama pull embeddinggemma`)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIM=768

# Optional local usage audit; candidate digests are hashes, not encrypted SQL.
LLM_AUDIT_PATH=
LLM_AUDIT_MAX_RECORDS=1000
LLM_AUDIT_CANDIDATE_DIGESTS=false
