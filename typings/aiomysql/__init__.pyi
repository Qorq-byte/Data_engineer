"""Project-used aiomysql 0.3.2 surface, checked against installed driver source.

This is a partial interface, not a runtime driver replacement. SQL cell values
remain dynamic; pool lifecycle and await/context-manager results are explicit.
"""

from abc import ABCMeta
from asyncio import AbstractEventLoop, Future
from collections.abc import Awaitable, Mapping, Sequence
from contextlib import AbstractAsyncContextManager
from typing import Any, Generic, TypedDict, TypeVar, Unpack, overload

_RowT = TypeVar("_RowT", default=tuple[Any, ...])
_Params = Sequence[object] | Mapping[str, object] | None

class _AwaitableContext[T](
    AbstractAsyncContextManager[T], Awaitable[T], metaclass=ABCMeta
): ...

class _ConnectionOptions(TypedDict, total=False):
    host: str
    port: int
    user: str
    password: str
    db: str
    charset: str
    autocommit: bool
    connect_timeout: float | None

class Cursor(Generic[_RowT]):
    rowcount: int
    lastrowid: int | None
    description: tuple[tuple[Any, ...], ...] | None
    @property
    def closed(self) -> bool: ...
    async def execute(self, query: str, args: _Params = None) -> int: ...
    async def executemany(self, query: str, args: Sequence[_Params]) -> int | None: ...
    def fetchone(self) -> Awaitable[_RowT | None]: ...
    def fetchmany(self, size: int | None = None) -> Awaitable[Sequence[_RowT]]: ...
    def fetchall(self) -> Awaitable[Sequence[_RowT]]: ...
    async def close(self) -> None: ...

class DictCursor(Cursor[dict[str, Any]]):
    def fetchall(self) -> Awaitable[list[dict[str, Any]]]: ...

class Connection:
    @property
    def closed(self) -> bool: ...
    @overload
    def cursor(self) -> _AwaitableContext[Cursor[tuple[Any, ...]]]: ...
    @overload
    def cursor[CursorT: Cursor[Any]](
        self, cursor: type[CursorT]
    ) -> _AwaitableContext[CursorT]: ...
    def close(self) -> None: ...
    async def ensure_closed(self) -> None: ...
    async def commit(self) -> None: ...
    async def rollback(self) -> None: ...
    async def ping(self, reconnect: bool = True) -> None: ...

class Pool:
    @property
    def size(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    def acquire(self) -> _AwaitableContext[Connection]: ...
    def release(self, conn: Connection) -> Future[None]: ...
    def close(self) -> None: ...
    async def wait_closed(self) -> None: ...

def create_pool(
    minsize: int = 1,
    maxsize: int = 10,
    echo: bool = False,
    pool_recycle: float = -1,
    loop: AbstractEventLoop | None = None,
    **kwargs: Unpack[_ConnectionOptions],
) -> _AwaitableContext[Pool]: ...
def connect(
    *, loop: AbstractEventLoop | None = None, **kwargs: Unpack[_ConnectionOptions]
) -> _AwaitableContext[Connection]: ...
