"""Partial pyarrow surface used by this repository; no runtime implementation.

Only the schema construction helpers reached from
``app.knowledge.retrieval.lancedb_store`` are declared: the ``Schema``/``DataType``
objects and the primitive, timestamp and fixed-size-list builders used to describe
LanceDB tables. ``pyarrow`` ships no ``py.typed`` marker, so these declarations
replace the blanket ``import-untyped`` silence with the exact surface the code uses.

Reading tables, compute kernels and record batches are not declared because the
repository does not call them from typed code; add them deliberately after
checking the installed version.
"""

from collections.abc import Iterable, Mapping

class DataType: ...
class Schema:
    def __init__(
        self,
        fields: Iterable[tuple[str, DataType]],
        metadata: Mapping[str, str] | None = ...,
    ) -> None: ...

def schema(
    fields: Iterable[tuple[str, DataType] | DataType], metadata: Mapping[str, str] | None = ...
) -> Schema: ...
def utf8() -> DataType: ...
def bool_() -> DataType: ...
def int32() -> DataType: ...
def int64() -> DataType: ...
def float32() -> DataType: ...
def float64() -> DataType: ...
def timestamp(unit: str, tz: str | None = ...) -> DataType: ...
def list_(value_type: DataType, list_size: int | None = ...) -> DataType: ...
